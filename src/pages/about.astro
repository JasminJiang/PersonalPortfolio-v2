---
import CloudflareMedia from "../components/CloudflareMedia.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  cloudflareImageSrcSet,
  cloudflareImageUrl,
  defaultResponsiveImageWidth,
} from "../lib/cloudflare-media";
import { mediaById } from "../lib/media-manifest";

const portrait = mediaById.get("about--portrait");
if (!portrait) throw new Error("About portrait is missing from the media manifest");
const portraitSocialImage = cloudflareImageUrl(portrait.webR2Key, 1200, { height: 630, fit: "cover" });
const portraitPreloadImage = cloudflareImageUrl(
  portrait.webR2Key,
  defaultResponsiveImageWidth(portrait, true),
);
const portraitSizes = "(max-width: 42rem) 100vw, 42vw";
const aboutStructuredData = {
  "@type": "ProfilePage",
  "@id": "https://jasminjiang.com/about/#page",
  url: "https://jasminjiang.com/about/",
  name: "About — Jasmin Xinjie Jiang",
  mainEntity: { "@id": "https://jasminjiang.com/#person" },
};
---

<BaseLayout
  title="About — Jasmin Xinjie Jiang"
  description="About Jasmin Xinjie Jiang, a multidisciplinary designer working across physical architecture and digital interfaces."
  bodyClass="about-page"
  showFooter={false}
  image={portraitSocialImage}
  imageAlt="Portrait of Jasmin Xinjie Jiang"
  type="profile"
  showHeader={false}
  preloadImage={portraitPreloadImage}
  preloadImageSrcSet={cloudflareImageSrcSet(portrait)}
  preloadImageSizes={portraitSizes}
  structuredData={aboutStructuredData}
>
  <article class="about-layout">
    <div class="about-layout__portrait" transition:name="about-portrait">
      <CloudflareMedia media={portrait} eager sizes={portraitSizes} />
    </div>

    <div class="about-layout__content">
      <nav class="about-layout__topbar" aria-label="About navigation">
        <a href="/">All projects</a>
      </nav>

      <div class="about-layout__main">
        <p class="section-label">About</p>
        <div class="about-layout__copy">
          <p>
            I’m Xinjie, a multidisciplinary designer operating at the intersection of physical architecture and digital interfaces. My practice is defined by two parallel tracks: crafting precision-driven UI/UX for screens and building immersive spatial experiences through AR/VR.
          </p>
          <p>
            By leveraging a technical background in coding and AI, I bridge the gap between architectural form and interactive logic. Whether it is an intuitive mobile interface or a complex XR environment, I ensure every pixel and every space is grounded in functional feasibility.
          </p>
          <p>
            With an aesthetic intuition rooted in photography, I transform complex systems into seamless visual narratives across both two-dimensional and spatial dimensions.
          </p>
        </div>

        <section class="about-contact" aria-labelledby="contact-heading">
          <p class="section-label" id="contact-heading">Contact</p>
          <div class="about-contact__links">
            <span>
              <a href="https://www.linkedin.com/in/xinjie-jiang-71811b369" target="_blank" rel="noreferrer">LinkedIn</a>
              <a href="https://www.instagram.com/jjjasminx1236/" target="_blank" rel="noreferrer">Instagram</a>
            </span>
            <a href="mailto:ahorajiang@gmail.com">Email</a>
          </div>
        </section>

        <p class="about-layout__signature">Jasmin Xinjie Jiang</p>
      </div>
    </div>
  </article>
</BaseLayout>
