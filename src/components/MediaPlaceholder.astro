---
import type { MediaManifestItem } from "../types/media";

interface Props {
  media: MediaManifestItem;
  eager?: boolean;
}

const { media, eager = false } = Astro.props;
const label = media.kind === "video" ? "Video" : media.role === "portrait" ? "Portrait" : "Image";
---

<figure
  class:list={["media-placeholder", { "media-placeholder--eager": eager, "media-placeholder--video": media.kind === "video" }]}
  style={`--media-ratio: ${media.width} / ${media.height}`}
  data-media-id={media.id}
  data-media-key={media.webR2Key}
>
  <div class="media-placeholder__surface" role="img" aria-label={media.alt}>
    <span>{label}</span>
    <span>{media.width} × {media.height}</span>
  </div>
  {media.kind === "video" && <figcaption>Motion media · poster prepared separately</figcaption>}
</figure>
