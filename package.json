    "@vitest/coverage-v8": "^4.1.10",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "lighthouse": "^13.4.1",
